{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IELTS Daily Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "date",
    "task",
    "level",
    "prompt_version",
    "review_of",
    "theme",
    "title",
    "review_words",
    "dialogue",
    "quiz"
  ],
  "properties": {
    "mode": {
      "const": "review"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task": {
      "type": "string",
      "enum": ["english"]
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "review_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "review_words": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "meaning_zh",
          "key_point_zh",
          "example",
          "translation_zh",
          "note_zh"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "meaning_zh": {
            "type": "string",
            "minLength": 1
          },
          "key_point_zh": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "translation_zh": {
            "type": "string",
            "minLength": 1
          },
          "note_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "text"],
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "options", "answer_index", "explanation_zh"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer_index": {
            "type": "integer",
            "enum": [0, 1, 2, 3]
          },
          "explanation_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
