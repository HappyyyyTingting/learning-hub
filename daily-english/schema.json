{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IELTS Daily Vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "task",
    "level",
    "prompt_version",
    "theme",
    "title",
    "words",
    "dialogue",
    "quiz",
    "review"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task": {
      "type": "string",
      "enum": ["english"]
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "words": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "ipa_us",
          "ipa_uk",
          "exam_frequency",
          "exam_focus_zh",
          "senses",
          "synonyms",
          "collocations",
          "word_forms",
          "examples"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "ipa_us": {
            "type": "string",
            "minLength": 1
          },
          "ipa_uk": {
            "type": "string",
            "minLength": 1
          },
          "exam_frequency": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "exam_focus_zh": {
            "type": "string",
            "minLength": 1
          },
          "senses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pos", "definition_zh", "definition_en"],
              "properties": {
                "pos": {
                  "type": "string",
                  "enum": ["v.", "n.", "adj.", "adv.", "prep.", "phrase", "idiom", "other"]
                },
                "definition_zh": {
                  "type": "string",
                  "minLength": 1
                },
                "definition_en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "synonyms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "pos", "definition_zh", "nuance_zh", "collocation"],
              "properties": {
                "term": {
                  "type": "string",
                  "minLength": 1
                },
                "pos": {
                  "type": "string",
                  "minLength": 1
                },
                "definition_zh": {
                  "type": "string",
                  "minLength": 1
                },
                "nuance_zh": {
                  "type": "string",
                  "minLength": 1
                },
                "collocation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "collocations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phrase", "meaning_zh"],
              "properties": {
                "phrase": {
                  "type": "string",
                  "minLength": 1
                },
                "meaning_zh": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "word_forms": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["form", "pos", "meaning_zh"],
              "properties": {
                "form": {
                  "type": "string",
                  "minLength": 1
                },
                "pos": {
                  "type": "string",
                  "minLength": 1
                },
                "meaning_zh": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "examples": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sentence", "translation_zh", "note_zh"],
              "properties": {
                "sentence": {
                  "type": "string",
                  "minLength": 1
                },
                "translation_zh": {
                  "type": "string",
                  "minLength": 1
                },
                "note_zh": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "text"],
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "options", "answer_index", "explanation_zh"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer_index": {
            "type": "integer",
            "enum": [0, 1, 2, 3]
          },
          "explanation_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "first_seen", "question", "answer"],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "first_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
