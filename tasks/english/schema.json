{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily English Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "task",
    "level",
    "prompt_version",
    "theme",
    "title",
    "words",
    "examples",
    "dialogue",
    "quiz",
    "review"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task": {
      "type": "string",
      "enum": ["english"]
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "words": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "ipa",
          "part_of_speech",
          "definition_en",
          "definition_zh",
          "example"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "ipa": {
            "type": "string",
            "minLength": 1
          },
          "part_of_speech": {
            "type": "string",
            "enum": ["noun", "verb", "adjective", "adverb", "phrase", "idiom", "other"]
          },
          "definition_en": {
            "type": "string",
            "minLength": 1
          },
          "definition_zh": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "text"],
        "properties": {
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "options", "answer_index", "explanation_zh"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer_index": {
            "type": "integer",
            "enum": [0, 1, 2, 3]
          },
          "explanation_zh": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "first_seen", "question", "answer"],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "first_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
